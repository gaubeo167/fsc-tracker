{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "firebase emulators:exec --config firebase.emulator.json --only firestore \"vitest run\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --config firebase.emulator.json --only auth,firestore,storage",
    "emulators:seed": "firebase emulators:start --config firebase.emulator.json --only auth,firestore,storage --import=emulator-data --export-on-exit=emulator-data",
    "rules:check": "firebase deploy --only firestore:rules,storage --dry-run",
    "rules:deploy": "firebase deploy --only firestore:rules,storage",
    "seed": "tsx scripts/seed-support.ts",
    "seed:rollback": "tsx scripts/seed-support-rollback.ts",
    "lint:scripts": "tsc --noEmit -p tsconfig.node.json",
    "dev:emulator": "vite --mode emulator --port=3100 --strictPort",
    "seed:test": "tsx scripts/seed-test-env.ts",
    "test:env": "firebase emulators:exec --config firebase.emulator.json --ui --only auth,firestore,storage \"npx tsx scripts/seed-test-env.ts && vite --mode emulator --port=3100 --strictPort\""
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^15.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}

rules_version = '2';

// ============================================================================
// FSC Tracker — Firebase Storage
// Bucket: fsc-tracker-2128a.firebasestorage.app (asia-southeast1)
//
// Nguyên tắc (§12 spec + Nghị định 13/2023):
//   - Bucket PRIVATE. publicAccessPrevention = enforced ở tầng GCS.
//   - Ảnh chụp lỗi RẤT dễ chứa thông tin cá nhân học sinh (tên trên màn hình
//     điểm danh, bảng điểm, hồ sơ y tế).
//   - Mặc định từ chối tất cả.
//
// ----------------------------------------------------------------------------
// ⛔️ KHÔNG GỌI firestore.get() Ở FILE NÀY. ĐÃ ĐO, NÓ KHÔNG CHẠY.
//
// Cross-service rules (đọc Firestore từ trong storage rules) KHÔNG hoạt động
// trên project này, dù IAM đã cấp đủ: service agent firebase-rules có
// roles/firebaserules.firestoreServiceAgent (datastore.entities.get).
//
// Bằng chứng đo thẳng trên production ngày 05/09/2026:
//   15:59:39  rules ghi = auth + dung lượng + định dạng + 2 lượt firestore.get
//             -> 403 ở MỌI lần thử, bucket không nhận được một file nào
//   16:17:46  rules ghi = auth + dung lượng + định dạng (bỏ 2 lượt đọc)
//   16:18:01  -> upload THÀNH CÔNG sau đúng 15 giây
// Khác nhau đúng một biến: hai lượt firestore.get. Cùng người dùng, cùng file,
// cùng đường dẫn, cùng bucket, cùng bundle. Dữ liệu đã kiểm tay và đều đúng
// (users.status = 'active', bản gán campusId = 'FSC', khớp thư mục trong path).
//
// Hệ quả: mọi câu allow gọi firestore.get đều TỪ CHỐI, im lặng, không log, và
// emulator thì cho qua hết. Đó là lý do tính năng đính kèm chết từ ngày mở mà
// không ai lần ra: triệu chứng trông y hệt lỗi phân quyền tài khoản.
//
// Vì vậy quyền ở đây chỉ được dựa vào thứ NẰM SẴN TRONG TOKEN đăng nhập. Muốn
// khoá lại theo trường đúng như thiết kế ban đầu thì phải đưa campusId vào
// custom claims, xem ghi chú ở nhánh đọc.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    /**
     * Người của tổ chức, xét bằng chính token đăng nhập — KHÔNG tốn lượt đọc nào.
     *
     * Vì sao không chỉ dùng `request.auth != null`: project này bật đăng nhập
     * Google, nên BẤT KỲ tài khoản Google nào trên đời cũng lấy được token của
     * project. App.tsx có chặn tên miền nhưng đó là chặn ở phía trình duyệt, ai
     * gọi thẳng API thì không đi qua nó. Ảnh ở đây có thông tin học sinh, nên
     * phép chặn tên miền phải nằm ở tầng rules.
     *
     * Email dev viết thẳng ra đây đúng như App.tsx đang làm. Thiếu nó thì chính
     * tài khoản đang dùng để kiểm thử bị khoá, và người kiểm thử lại đi tìm một
     * con bug không tồn tại.
     */
    function laNguoiNoiBo() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && (request.auth.token.email.matches('.*@fpt[.]edu[.]vn')
                 || request.auth.token.email.matches('.*@fe[.]edu[.]vn')
                 || request.auth.token.email == 'viet88.nb@gmail.com');
    }

    // Chốt chặn mặc định.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Ảnh đính kèm phiếu hỗ trợ.
    //
    // Đường dẫn: support-tickets/{campusId}/{draftId}/{fileName}
    //
    // Mã trường vẫn nằm trong đường dẫn dù rules không còn kiểm được nó. Giữ
    // lại vì hai lẽ: soi bucket thì con người vẫn đọc ra ảnh thuộc trường nào,
    // và đó là chỗ cắm lại phép kiểm ngay khi có custom claims, không phải dời
    // một file nào.
    // ------------------------------------------------------------------
    match /support-tickets/{campusId}/{draftId}/{fileName} {

      /**
       * ĐÁNH ĐỔI CÓ CHỦ ĐÍCH: lượt xem không còn cách ly theo trường.
       *
       * Rules không hỏi được Firestore nên không có cách nào biết người đang xem
       * thuộc trường nào. Ba lựa chọn, và vì sao chọn cái này:
       *
       *   1. Chỉ người tải lên xem được   -> cán bộ đầu mối và kỹ thuật viên
       *      PTUD không xem được ảnh của chính phiếu họ đang xử lý. Giết luôn
       *      tính năng.
       *   2. Không ai xem được            -> đúng cái đang xảy ra hôm nay.
       *   3. Người nội bộ xem được (chọn) -> tính năng chạy, ranh giới thật
       *      chuyển sang Firestore.
       *
       * Vì sao (3) chấp nhận được: đường dẫn ảnh CHỈ nằm trong document phiếu,
       * mà quyền đọc phiếu do firestore.rules khoá theo trường. Không đọc được
       * phiếu thì không biết đường dẫn mà đòi.
       *
       * Chỗ thật sự mất: phiếu SYSTEM_WIDE. Trường khác đọc được phiếu đó nên
       * giờ đọc được cả ảnh của nó, trong khi rule cũ cố tình chặn.
       *
       * Cách đóng lại: đẩy campusId vào custom claims (một endpoint Admin SDK
       * gọi setCustomUserClaims lúc gán trường), rồi đổi dòng dưới thành
       *     laNguoiNoiBo() && request.auth.token.campusId == campusId
       * Không tốn lượt đọc nào và khôi phục đúng cách ly ban đầu.
       */
      allow read: if laNguoiNoiBo();

      /**
       * `create, update` chứ KHÔNG phải `write`: `write` gộp cả delete nên nó
       * làm câu `allow delete: if false` bên dưới thành vô nghĩa.
       */
      allow create, update: if laNguoiNoiBo()
                   // §10: tối đa 10MB mỗi file.
                   && request.resource.size <= 10 * 1024 * 1024
                   && isAllowedType();

      /**
       * Ảnh (báo lỗi) và tài liệu (đề xuất tính năng).
       *
       * Danh sách LIỆT KÊ TƯỜNG MINH, không dùng matches('.*') cho tài liệu:
       * một biểu thức lỏng sẽ nhận cả application/x-msdownload và
       * application/x-sh. Bucket này ai trong tổ chức cũng ghi được, nên nó
       * không được phép trở thành nơi phát tán file thực thi.
       *
       * Cố ý KHÔNG có zip/rar: không kiểm được nội dung bên trong.
       * Cố ý KHÔNG có video: 10MB video vô dụng, mà mở ra thì tốn băng thông.
       *
       * Viết bằng cú pháp cơ bản nhất, không dùng `let`: runtime storage rules
       * của production đã cho thấy nó lệch emulator ở những chỗ không lường
       * trước được, nên file này chỉ dùng cấu trúc chắc chắn chạy.
       */
      function isAllowedType() {
        return request.resource.contentType.matches('image/.*')
          || request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'text/plain',
          'text/csv'
        ];
      }

      // Không cho xoá: ảnh là bằng chứng của phiếu. Phiếu đã không xoá được thì
      // ảnh cũng vậy, nếu không người ta xoá bằng chứng sau khi phiếu bị từ chối.
      allow delete: if false;
    }
  }
}

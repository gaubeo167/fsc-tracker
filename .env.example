# ============================================================================
# FSC Tracker — biến môi trường
# Copy file này thành .env.local rồi điền giá trị thật.
#   cp .env.example .env.local
#
# Lấy giá trị ở đâu: Firebase Console -> Project settings -> General
#   https://console.firebase.google.com/project/fsc-tracker-2128a/settings/general
# ============================================================================

# ----------------------------------------------------------------------------
# CLIENT (trình duyệt) — bắt buộc cả 7 biến, thiếu 1 biến là app không chạy.
#
# ⚠️ Mọi biến có tiền tố VITE_ đều được nhúng thẳng vào bundle và AI ĐỌC CŨNG ĐƯỢC.
#    Tuyệt đối không đặt secret ở đây. Firebase apiKey KHÔNG phải secret —
#    nó chỉ định danh project, việc chặn truy cập là do firestore.rules làm.
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fsc-tracker-2128a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fsc-tracker-2128a
VITE_FIREBASE_STORAGE_BUCKET=fsc-tracker-2128a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore database id.
# Để trống = dùng "(default)" (vùng nam5, Mỹ — database app đang chạy thật).
# Đặt "fsc-asia" để trỏ sang database asia-southeast1 (Singapore).
# Xem danh sách: gcloud firestore databases list --project=fsc-tracker-2128a
VITE_FIREBASE_DATABASE_ID=

# Nối vào emulator khi phát triển local. Đặt "true" rồi chạy: npm run emulators
VITE_USE_EMULATOR=

# ----------------------------------------------------------------------------
# SERVER-ONLY — chỉ dùng trong api/ và scripts/.
#
# ⚠️ TUYỆT ĐỐI KHÔNG thêm tiền tố VITE_ cho mấy biến dưới đây.
#    Thêm VITE_ là đẩy thẳng credential toàn quyền ra bundle cho cả thế giới đọc.
#    Trên Vercel: đặt ở Project Settings -> Environment Variables.
# ----------------------------------------------------------------------------

# Service account của firebase-admin, encode base64 nguyên file JSON thành 1 dòng.
# Dùng base64 thay vì đường dẫn file để không có credential nào nằm trên đĩa.
#   cat service-account.json | base64 | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Firestore database id cho phía server. Phải TRÙNG với VITE_FIREBASE_DATABASE_ID,
# nếu không thì api/ và trình duyệt đọc ghi vào hai database khác nhau.
FIRESTORE_DATABASE_ID=

# Resend — gửi digest email 17:00 hằng ngày
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Chuỗi bí mật bảo vệ các route cron. Scheduler phải gửi kèm header
#   X-Cron-Secret: <giá trị này>
# Sinh chuỗi mới: openssl rand -hex 32
CRON_SECRET=
